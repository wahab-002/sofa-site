NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Keep "false" only when you want the live Supabase database instead of local catalog photos.
# Optional: force offline local catalog (skips Supabase even if configured)
NEXT_PUBLIC_USE_LOCAL_CATALOG=false
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wholesale card checkout (/wholesale — unlisted). Use Stripe test keys locally.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
